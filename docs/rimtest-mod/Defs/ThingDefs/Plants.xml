<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       测试用观赏植物 —— 走技能「场景③ 无模板新类型」流程做出的 Def
       核验来源：Data/Core/Defs/ThingDefs_Plants/Plants_Bases.xml（ParentName 链）
                 Data/Core/Defs/ThingDefs_Plants/Plants_Cultivated_Decorative.xml（Plant_Rose / Plant_Daylily）
                 RimWorld-1.7-代码模板集 03-全量字段参考/字段总表.csv（各 plant/* 字段在 1.7 的出现率）
       字段核验（出现次数/2054 个 ThingDef 实例）：plant/growDays 3.89%、plant/lifespanDaysPerGrowDays 0.63%、
       plant/sowWork 0.58%、plant/sowTags 1.56%、plant/purpose 1.02%、plant/visualSizeRange 3.31%、
       plant/topWindExposure 2.87%、plant/growMinGlow 0.78%、plant/dieIfLeafless 0.97%、plant/harvestTag 1.36%
       ============================================================ -->
  <ThingDef ParentName="PlantBase">
    <defName>DM_Plant_TestBloom</defName>
    <label>test bloom</label>
    <description>A bright little flower grown only for tests. It looks suspiciously like it was drawn by a machine.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <!-- 观赏植物的核心价值：美观度（室内/室外各一项） -->
      <Beauty>16</Beauty>
      <BeautyOutdoors>16</BeautyOutdoors>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/DM_TestBloom</texPath>
      <!-- 原版装饰植物（Plant_Rose/Plant_Daylily）用 Graphic_Random，但那要求贴图是目录形态
           （Things/Plant/Blossom/Blossom_a.png 这种 <texPath>/<任意名>.png）。
           本 Def 按 _SPEC 第 5 节的 texPath 契约只有一张平铺文件 DM_TestBloom.png，
           若写 Graphic_Random 会在运行时抛 "Collection cannot init: No textures found at path"，
           因此这里用 Graphic_Single。
           核验：Assembly-CSharp.dll 内含字符串 "Collection cannot init" / "No textures found at path"（Graphic_Collection.Init）。 -->
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <ingestible>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
    <plant>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <sowWork>540</sowWork>
      <sowTags>
        <li>Ground</li>
        <li>Decorative</li>
      </sowTags>
      <growMinGlow>0.3</growMinGlow>
      <topWindExposure>0.1</topWindExposure>
      <growDays>1.5</growDays>
      <lifespanDaysPerGrowDays>3</lifespanDaysPerGrowDays>
      <visualSizeRange>0.3~1.05</visualSizeRange>
      <wildOrder>1</wildOrder>
      <purpose>Beauty</purpose>
    </plant>
  </ThingDef>

</Defs>
