<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- AI 辅助生成 | 目标平台 RimWorld 1.7.4981 rev136（线 A / XML）
       目标文件（1.7 原版真实存在，已逐行读过）：
         Core/Defs/ThingDefs_Misc/Weapons/RangedIndustrial.xml:20  <ThingDef Name="Gun_Revolver" ParentName="BaseHumanMakeableGun">
       三个操作分别验证三种不同的 PatchOperation（1.7 补丁框架类型实测：Verse.PatchOperationAdd /
       Verse.PatchOperationReplace / Verse.PatchOperationInsert 等共 17 个 PatchOperation* 类型，由 Assembly-CSharp.dll 反射得到；
       注意 1.7 并不存在 1.6 文档里说的 Verse.PatchOperationSet，补丁节点名是 <Operation>、类型由 Class 属性决定）。
       三个 xpath 在 1.7 原版 Data 里有且只有 Gun_Revolver 一处命中：
         statBases/RangedWeapon_Cooldown 原值 1.6、weaponTags 原值 li=SimpleGun / li=Revolver、tools 原值 li=grip / li=barrel。 -->

  <!-- 1) 替换：把左轮的冷却从 1.6 秒改成 1.4 秒（字段路径来自原版实例，不是猜的） -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Gun_Revolver"]/statBases/RangedWeapon_Cooldown</xpath>
    <value>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </value>
  </Operation>

  <!-- 2) 添加：给左轮追加一个武器标签（列表追加到末尾，原 SimpleGun / Revolver 保留） -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="Gun_Revolver"]/weaponTags</xpath>
    <value>
      <li>DM_Patch_TestTag</li>
    </value>
  </Operation>

  <!-- 3) 插入：给左轮插一条枪托近战攻击并放在 tools 列表最前面（order 取 Prepend/Append）
       注意 xpath 必须指向列表里【已有的某个节点】：PatchOperationInsert 的语义是
       「把 value 插成匹配节点的兄弟节点」，写 /tools（列表容器本身）会把 <li> 插到 <ThingDef> 的直接子级，
       运行时直接报 XML 字段错误。这里用 /tools/li[1] + Prepend = 插到第一个工具（grip）之前。 -->
  <Operation Class="PatchOperationInsert">
    <xpath>/Defs/ThingDef[defName="Gun_Revolver"]/tools/li[1]</xpath>
    <order>Prepend</order>
    <value>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </value>
  </Operation>

</Patch>

