{
  "name": "rimworld-modding-skill-evals",
  "description": "Baseline evaluation prompts for rimworld-modding skill",
  "prompts": [
    {
      "id": "create-melee-weapon",
      "prompt": "帮我创建一把近战武器——等离子匕首，伤害18，冷却1.2秒，Ultratech科技等级",
      "expect": {
        "contains": [
          "ParentName=\"BaseMeleeWeapon_Sharp_Quality\"",
          "costStuffCount",
          "stuffCategories",
          "Metallic",
          "possessionCount",
          "<techLevel>Ultra</techLevel>"
        ],
        "not_contains": [
          "CompProperties_Equippable"
        ],
        "not_contains_line": [
          "^\\s*<techLevel>\\s*Ultratech\\s*</techLevel>",
          "^\\s*<costList>"
        ]
      }
    },
    {
      "id": "create-ranged-weapon",
      "prompt": "帮我创建一把远程武器——离子步枪，射程30，伤害15",
      "expect": {
        "contains": [
          "ParentName=\"BaseHumanMakeableGun\"",
          "Verb_Shoot",
          "<range>"
        ],
        "not_contains": [
          "BaseRangedWeapon"
        ],
        "not_contains_line": [
          "^\\s*<rangedWeapon_Range[\\s>/]"
        ]
      }
    },
    {
      "id": "check-techlevel-enum",
      "prompt": "RimWorld 近战武器的 techLevel 枚举值有哪些？帮我列出合法的值",
      "expect": {
        "contains": [
          "Neolithic",
          "Medieval",
          "Industrial",
          "Spacer",
          "Ultra"
        ],
        "not_contains_line": [
          "^\\s*(?:[-*+|]\\s*)?`?Ultratech`?\\s*(?:[|:：=]|$)",
          "^\\s*(?:[-*+|]\\s*)?`?Industry`?\\s*(?:[|:：=]|$)"
        ]
      }
    },
    {
      "id": "debug-missing-def",
      "prompt": "我的武器mod在游戏里搜索不到defName，怎么排查？",
      "expect": {
        "contains_any": [
          [
            "Player.log"
          ],
          [
            "Logs\\Player.log",
            "Logs/Player.log"
          ],
          [
            "Data/Core/Defs",
            "原版",
            "Core"
          ],
          [
            "grep",
            "搜索",
            "检索",
            "find"
          ]
        ]
      }
    }
  ]
}
